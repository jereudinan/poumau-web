{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "poumau-official-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/admin*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "poumau-web",
			"database_id": "9a421a9a-96a6-4266-add4-416d0f8d32ae"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "poumau-media"
		}
	],
	"vars": {
		"PUBLIC_SITE_URL": "https://poumau.com",
		"CONTACT_RETENTION_YEARS": "3",
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEESCH4wrxa36cFU",
		"TEAM_DOMAIN": "https://poumau.cloudflareaccess.com",
		"POLICY_AUD": "cb4b494c53ea58bdc17b5a09fe0b1f714a816af136410093a3582c001441e461"
	},
	"observability": {
		"enabled": true
	}
}
