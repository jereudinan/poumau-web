{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "poumau-official-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/admin*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "poumau-web"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "poumau-media"
		}
	],
	"vars": {
		"PUBLIC_SITE_URL": "https://poumau.com",
		"CONTACT_RETENTION_YEARS": "3"
	},
	"observability": {
		"enabled": true
	}
}
