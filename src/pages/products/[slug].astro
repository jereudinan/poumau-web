---
import { env } from 'cloudflare:workers'; import BaseLayout from '../../layouts/BaseLayout.astro'; import type { Product } from '../../lib/types';
let product:Product|null=null;try{product=await env.DB.prepare('SELECT * FROM products WHERE slug=? AND is_visible=1').bind(Astro.params.slug).first<Product>()}catch{}if(!product) return Astro.redirect('/products'); const images=JSON.parse(product.image_urls||'[]') as string[];
---
<BaseLayout title={`${product.name} | 파우마우`} description={product.summary} image={product.thumbnail_url??undefined}><section class="section"><div class="container detail"><div><div class="main-image">{product.thumbnail_url&&<img src={product.thumbnail_url} alt={product.alt_text}/>}</div>{images.length>0&&<div class="thumbs">{images.map((src,i)=><img src={src} alt={`${product.alt_text} 상세 ${i+1}`}/>)}</div>}</div><article><p class="eyebrow">{product.category}</p><h1>{product.name}</h1><p class="lead">{product.summary}</p><div class="description" set:html={product.description.replaceAll('\n','<br/>')}></div><div class="actions">{product.status==='available'&&product.smartstore_url&&<a class="btn btn--pink" href={product.smartstore_url} target="_blank" rel="noreferrer">스마트스토어 구매</a>}<a class="btn btn--ghost" href={`/contact?type=상품 문의&product=${encodeURIComponent(product.name)}`}>상품 문의하기</a></div>{product.status==='sold_out'&&<p class="soldout">현재 품절된 상품입니다. 재입고와 커스텀 제작은 문의해 주세요.</p>}</article></div></section></BaseLayout><style>.detail{display:grid;grid-template-columns:1.1fr .9fr;gap:70px}.main-image{overflow:hidden;min-height:520px;border-radius:var(--radius-md);background:var(--soft)}.main-image img{width:100%;height:100%;object-fit:cover}.detail h1{font-size:clamp(2.4rem,5vw,4.6rem)}.description{margin:34px 0;color:var(--muted)}.actions{display:flex;gap:10px;flex-wrap:wrap}.soldout{margin-top:20px;color:var(--pink-dark)}.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}.thumbs img{aspect-ratio:1;object-fit:cover;border-radius:10px}@media(max-width:760px){.detail{grid-template-columns:1fr}.main-image{min-height:360px}}</style>
