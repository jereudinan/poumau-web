---
import { env } from 'cloudflare:workers'; import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import { PRODUCT_CATEGORIES,SITE } from '../../lib/constants'; import type { Product } from '../../lib/types';
let products:Product[]=[];try{products=(await env.DB.prepare('SELECT * FROM products WHERE is_visible=1 ORDER BY sort_order,id DESC').all<Product>()).results}catch{}
---
<BaseLayout title="상품소개 | 파우마우" description="파우치, 가방, 키링, 패션 소품 등 파우마우의 패브릭 핸드메이드 상품을 만나보세요."><PageHero eyebrow="Products" title="매일의 쓰임에 즐거움을 더하는 물건" description="모든 제품은 커스텀 제작이 가능합니다. 제품별 구매 링크 또는 문의를 통해 만나보세요."/><section class="section section--soft"><div class="container"><div class="filters" aria-label="상품 분류"><button class="is-active" data-filter="all">전체</button>{PRODUCT_CATEGORIES.map(c=><button data-filter={c}>{c}</button>)}</div>{products.length?<div class="grid-3 product-grid">{products.map(p=><a class="card reveal product" data-category={p.category} href={`/products/${p.slug}`}><div class="card-media">{p.thumbnail_url&&<img src={p.thumbnail_url} alt={p.alt_text}/>}</div><div class="card-body"><div class="card-meta"><span>{p.category}</span><span>{p.status==='sold_out'?'품절':'판매중'}</span></div><h3>{p.name}</h3><p>{p.summary}</p></div></a>)}</div>:<div class="empty"><img src="/images/brand/poumau-cat.png" alt=""/><h3>상품 등록을 준비하고 있습니다</h3><p>관리자 페이지에서 상품을 등록하면 이곳에 표시됩니다.</p><a class="btn btn--small" href={SITE.smartStore} target="_blank" rel="noreferrer">스마트스토어 방문</a></div>}</div></section></BaseLayout>
<script>document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.classList.remove('is-active'));btn.classList.add('is-active');document.querySelectorAll<HTMLElement>('.product').forEach(card=>card.hidden=btn.dataset.filter!=='all'&&card.dataset.category!==btn.dataset.filter)}));</script><style>.filters{display:flex;gap:8px;margin-bottom:34px;flex-wrap:wrap}.filters button{padding:10px 18px;border:1px solid var(--line);border-radius:999px;background:#fff}.filters button.is-active{border-color:var(--ink);background:var(--ink);color:#fff}</style>
