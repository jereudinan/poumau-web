---
import { env } from 'cloudflare:workers'; import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import type { Store } from '../lib/types';
let stores:Store[]=[];try{stores=(await env.DB.prepare('SELECT * FROM stores WHERE is_visible=1 ORDER BY sort_order,id DESC').all<Store>()).results}catch{}
---
<BaseLayout title="오프라인 입점처 | 파우마우" description="전국의 위탁 매장과 기프트샵에서 파우마우 제품을 직접 만나보세요."><PageHero eyebrow="Offline stores" title="가까운 공간에서 직접 만나요" description="파우마우 제품을 만나볼 수 있는 위탁 매장과 기프트샵을 안내합니다. 방문 전 매장 운영 정보를 확인해 주세요."/><section class="section section--soft"><div class="container">{stores.length?<div class="store-list">{stores.map(s=><article class="store reveal"><div class="store-image">{s.image_url?<img src={s.image_url} alt={s.alt_text}/>:<img class="placeholder" src="/images/brand/poumau-cat.png" alt=""/>}</div><div><span class="pill">입점처</span><h2>{s.name}</h2><p>{s.description}</p><dl><div><dt>주소</dt><dd>{s.address}</dd></div>{s.hours&&<div><dt>운영시간</dt><dd>{s.hours}</dd></div>}</dl><a class="btn btn--ghost arrow" href={s.naver_map_url} target="_blank" rel="noreferrer">네이버 지도</a></div></article>)}</div>:<div class="empty"><img src="/images/brand/poumau-cat.png" alt=""/><h3>입점처 정보를 정리하고 있습니다</h3><p>방문 가능한 공간을 확인해 곧 안내하겠습니다.</p></div>}</div></section></BaseLayout><style>.store-list{display:grid;gap:30px}.store{display:grid;grid-template-columns:.9fr 1.1fr;gap:50px;padding:28px;border-radius:var(--radius-md);background:#fff}.store-image{display:grid;min-height:360px;place-items:center;overflow:hidden;border-radius:16px;background:#eee5d5}.store-image>img:not(.placeholder){width:100%;height:100%;object-fit:cover}.placeholder{width:50%;opacity:.55}.store h2{margin:16px 0;font-size:2.2rem}.store dl{margin:28px 0}.store dl div{display:grid;grid-template-columns:100px 1fr;padding:10px 0;border-top:1px solid var(--line)}.store dt{font-weight:700}.store dd{margin:0;color:var(--muted)}@media(max-width:760px){.store{grid-template-columns:1fr;gap:28px}.store-image{min-height:260px}}</style>
