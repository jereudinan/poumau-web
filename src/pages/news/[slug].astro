---
import { env } from 'cloudflare:workers'; import BaseLayout from '../../layouts/BaseLayout.astro'; import type { NewsPost } from '../../lib/types';
let post:NewsPost|null=null;try{post=await env.DB.prepare('SELECT * FROM news_posts WHERE slug=? AND is_visible=1').bind(Astro.params.slug).first<NewsPost>()}catch{}if(!post)return Astro.redirect('/news');
---
<BaseLayout title={`${post.title} | 파우마우 소식`} description={post.body.slice(0,150)} image={post.thumbnail_url??undefined}><article class="article"><header class="container article-head"><p class="eyebrow">News</p><h1>{post.title}</h1><time datetime={post.published_at}>{post.published_at.slice(0,10)}</time></header>{post.thumbnail_url&&<div class="container cover"><img src={post.thumbnail_url} alt={post.alt_text}/></div>}<div class="container prose" set:html={post.body.replaceAll('\n','<br/>')}></div>{post.external_url&&<div class="container external"><a class="btn btn--ghost arrow" href={post.external_url} target="_blank" rel="noreferrer">관련 링크 보기</a></div>}<div class="container back"><a href="/news">← 소식 목록</a></div></article></BaseLayout><style>.article{padding:100px 0}.article-head{max-width:900px;text-align:center}.article h1{font-size:clamp(2.5rem,5.5vw,5.2rem)}.article time{color:var(--muted)}.cover{margin-top:64px}.cover img{width:100%;max-height:680px;object-fit:cover;border-radius:var(--radius-md)}.prose{max-width:780px;padding-top:64px;font-size:1.08rem;line-height:2}.external,.back{max-width:780px;margin-top:42px}.back{padding-top:30px;border-top:1px solid var(--line)}</style>
