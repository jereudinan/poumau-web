---
import { env } from 'cloudflare:workers'; import BaseLayout from '../layouts/BaseLayout.astro'; import type { Product, NewsPost, Store } from '../lib/types'; import { SITE } from '../lib/constants';
let products:Product[]=[]; let posts:NewsPost[]=[]; let stores:Store[]=[]; const db=env.DB;
if(db){try{[products,posts,stores]=await Promise.all([db.prepare('SELECT * FROM products WHERE is_visible=1 AND is_featured=1 ORDER BY sort_order,id DESC LIMIT 6').all<Product>().then(r=>r.results),db.prepare('SELECT * FROM news_posts WHERE is_visible=1 ORDER BY published_at DESC LIMIT 3').all<NewsPost>().then(r=>r.results),db.prepare('SELECT * FROM stores WHERE is_visible=1 ORDER BY sort_order,id DESC LIMIT 3').all<Store>().then(r=>r.results)])}catch{}}
---
<BaseLayout>
  <section class="hero" aria-label="파우마우 주요 이야기">
    <div class="slides">
      <article class="slide slide--one is-active"><div class="container hero-grid"><div><p class="eyebrow">Fabric handmade studio</p><h1>일상의 가치가<br/><em>소소한 행복</em>으로</h1><p>매일 손이 가는 물건일수록 더 다정하게. 파우마우는 쓰임과 마음을 함께 담아 만듭니다.</p><div class="hero-actions"><a class="btn btn--pink" href="/products">상품 둘러보기</a><a class="btn btn--ghost" href="/about">브랜드 이야기</a></div></div></div></article>
      <article class="slide slide--two"><div class="container hero-grid"><div><p class="eyebrow">Made by hand</p><h1>손끝에서 시작되는<br/><em>작은 차이</em></h1><p>원단의 촉감부터 봉제의 마무리까지, 공산품과 다른 핸드메이드의 가치를 전합니다.</p><div class="hero-actions"><a class="btn" href="/about">파우마우 소개</a></div></div></div></article>
      <article class="slide slide--three"><div class="container hero-grid"><div><p class="eyebrow">Custom made together</p><h1>우리만의 이야기를<br/><em>제품으로</em></h1><p>모든 제품은 수량과 디자인을 협의해 커스텀 제작할 수 있습니다. 기관·브랜드와 함께할 제안을 기다립니다.</p><div class="hero-actions"><a class="btn btn--pink" href="/contact?type=제휴·협업 문의">커스텀 문의하기</a></div></div></div></article>
    </div>
    <div class="slider-controls" role="group" aria-label="슬라이드 선택">
      <button class="slider-dot is-active" type="button" aria-label="첫 번째 슬라이드" aria-current="true" data-slide="0"></button>
      <button class="slider-dot" type="button" aria-label="두 번째 슬라이드" data-slide="1"></button>
      <button class="slider-dot" type="button" aria-label="세 번째 슬라이드" data-slide="2"></button>
    </div>
  </section>

  <section class="section"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">Featured products</p><h2>오래 곁에 둘 물건</h2></div><a class="btn btn--ghost arrow" href="/products">전체 상품</a></div>{products.length?<div class="grid-3">{products.map(p=><a class="card reveal" href={`/products/${p.slug}`}><div class="card-media">{p.thumbnail_url&&<img src={p.thumbnail_url} alt={p.alt_text}/>}</div><div class="card-body"><div class="card-meta"><span>{p.category}</span><span>{p.status==='sold_out'?'품절':'판매중'}</span></div><h3>{p.name}</h3><p>{p.summary}</p></div></a>)}</div>:<div class="empty reveal"><img src="/images/brand/poumau-cat.png" alt=""/><h3>곧 새로운 상품을 소개할게요</h3><p>관리자에서 대표 상품을 등록하면 이곳에 자동으로 표시됩니다.</p><a class="btn btn--small" href={SITE.smartStore} target="_blank" rel="noreferrer">스마트스토어 먼저 보기</a></div>}</div></section>

  <section class="section section--soft"><div class="container story-grid reveal"><div class="story-art"><img src="/images/brand/poumau-cat.png" alt="파우마우 캐릭터"/></div><div><p class="eyebrow">About poumau</p><h2>평범한 하루에<br/>다정한 쓰임을 더합니다</h2><p class="lead">2015년 시작한 파우마우는 높은 완성도와 남다른 기획으로 패브릭 핸드메이드 제품을 만듭니다. 최초보다 변함없는 최고를 지향합니다.</p><p class="donation">수익의 일부는 유기동물 구조 단체에 후원금으로 사용됩니다.</p><a class="btn btn--ghost arrow" href="/about">브랜드 더 알아보기</a></div></div></section>

  <section class="section custom-section"><div class="container reveal"><p class="eyebrow">Custom order</p><div class="custom-copy"><h2>당신의 아이디어에<br/>파우마우의 손길을</h2><div><p class="lead">모든 제품은 커스텀 제작이 가능합니다. 원단, 색상, 수량, 패키지를 문의 후 함께 협의해 보세요.</p><a class="btn btn--pink" href="/contact?type=제휴·협업 문의">제작 문의하기</a></div></div></div></section>

  <section class="section section--soft"><div class="container reveal"><div class="section-head"><div><p class="eyebrow">Partners & channels</p><h2>다양한 곳에서 만나는 파우마우</h2></div></div><div class="partner-list"><span>신세계 프리미엄 아울렛</span><span>국립백두대간수목원</span><span>국립세종수목원</span><span>NAVER</span><span>coupang</span><span>idus</span></div></div></section>

  <section class="section"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">Offline</p><h2>직접 만나는 공간</h2></div><a class="btn btn--ghost arrow" href="/offline">전체 입점처</a></div>{stores.length?<div class="grid-3">{stores.map(s=><article class="card reveal"><div class="card-media">{s.image_url&&<img src={s.image_url} alt={s.alt_text}/>}</div><div class="card-body"><h3>{s.name}</h3><p>{s.address}</p><a href={s.naver_map_url} target="_blank" rel="noreferrer">네이버 지도 ↗</a></div></article>)}</div>:<div class="empty reveal"><p>오프라인 입점처 정보를 준비하고 있습니다.</p></div>}</div></section>

  <section class="section section--soft"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">Latest news</p><h2>파우마우의 새 소식</h2></div><a class="btn btn--ghost arrow" href="/news">소식 전체보기</a></div>{posts.length?<div class="grid-3">{posts.map(p=><a class="card reveal" href={`/news/${p.slug}`}><div class="card-media">{p.thumbnail_url&&<img src={p.thumbnail_url} alt={p.alt_text}/>}</div><div class="card-body"><div class="card-meta"><time>{p.published_at.slice(0,10)}</time></div><h3>{p.title}</h3><p>{p.body.slice(0,90)}{p.body.length>90?'…':''}</p></div></a>)}</div>:<div class="empty reveal"><p>첫 번째 소식을 준비하고 있습니다.</p></div>}</div></section>

  <section class="section contact-cta"><div class="container reveal"><div><p class="eyebrow">Let's make together</p><h2>함께 만들 이야기가 있나요?</h2><p>상품, 입점, 도매, 협업에 관한 제안을 남겨주세요.</p></div><a class="btn btn--pink" href="/contact">문의 남기기</a></div></section>
</BaseLayout>
<script>const slides=[...document.querySelectorAll<HTMLElement>('.slide')];const dots=[...document.querySelectorAll<HTMLButtonElement>('.slider-dot')];let current=0;let timer:number;const paint=(next:number)=>{slides[current]?.classList.remove('is-active');dots[current]?.classList.remove('is-active');dots[current]?.removeAttribute('aria-current');current=(next+slides.length)%slides.length;slides[current]?.classList.add('is-active');dots[current]?.classList.add('is-active');dots[current]?.setAttribute('aria-current','true')};const play=()=>{window.clearInterval(timer);timer=window.setInterval(()=>paint(current+1),6500)};dots.forEach(dot=>dot.addEventListener('click',()=>{paint(Number(dot.dataset.slide));play()}));play();</script>
<style>
.hero{position:relative;min-height:720px;overflow:hidden}.slides{min-height:720px}.slide{position:absolute;inset:0;display:grid;align-items:center;opacity:0;pointer-events:none;transform:scale(1.015);transition:opacity .7s,transform 1s}.slide.is-active{opacity:1;pointer-events:auto;transform:none}.slide--one{background:#f8f0ed}.slide--two{background:#eee7da}.slide--three{background:#f4ece3}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:50px}.hero h1{margin-bottom:25px}.hero h1 em{color:var(--pink);font-style:normal}.hero p:not(.eyebrow){max-width:540px;color:var(--muted);font-size:1.08rem}.hero-actions{display:flex;gap:12px;margin-top:34px}.hero-art{position:relative;display:grid;place-items:center;min-height:540px}.hero-art img{position:relative;z-index:2;width:min(78%,480px);filter:drop-shadow(0 28px 28px rgba(53,50,49,.18))}.orbit{position:absolute;border:1px solid rgba(244,95,118,.35);border-radius:50%}.orbit--a{width:480px;height:480px}.orbit--b{width:620px;height:620px}.material-art{position:relative;height:460px}.material-art i{position:absolute;width:58%;height:58%;border-radius:38px;box-shadow:var(--shadow);transform:rotate(-12deg);background:#f46b7e}.material-art i:nth-child(2){top:14%;left:20%;transform:rotate(7deg);background:#d9c8ac}.material-art i:nth-child(3){top:30%;left:38%;transform:rotate(-2deg);background:#353231}.material-art strong{position:absolute;z-index:3;right:8%;bottom:14%;color:#fff;font-size:clamp(2rem,5vw,5rem);font-style:italic}.custom-art{display:grid;place-items:center;min-height:470px;border:1px solid rgba(53,50,49,.12);border-radius:50%;position:relative}.custom-art img{width:65%}.custom-art span{position:absolute;padding:10px 16px;border-radius:999px;background:#fff;box-shadow:var(--shadow);font-weight:700}.custom-art span:nth-of-type(1){top:15%;left:8%}.custom-art span:nth-of-type(2){top:24%;right:2%}.custom-art span:nth-of-type(3){bottom:13%;right:16%}.slider-controls{position:absolute;z-index:5;bottom:30px;left:50%;display:flex;gap:10px;transform:translateX(-50%)}.slider-dot{width:9px;height:9px;padding:0;border:0;border-radius:50%;background:rgba(31,29,29,.28);transition:width .2s,background .2s}.slider-dot.is-active{width:28px;border-radius:999px;background:var(--pink)}.slider-dot:focus-visible{outline:3px solid rgba(244,95,118,.3);outline-offset:4px}.story-grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:80px}.story-art{display:grid;place-items:center;min-height:520px;border-radius:var(--radius-lg);background:#eadfc8}.story-art img{width:72%;filter:drop-shadow(0 24px 22px rgba(53,50,49,.18))}.donation{margin:28px 0;padding:16px 18px;border-left:3px solid var(--pink);background:#fff;color:var(--ink)}.custom-section{background:var(--charcoal);color:#fff}.custom-section .eyebrow{color:#ff8799}.custom-copy{display:grid;grid-template-columns:1.2fr .8fr;align-items:end;gap:60px}.custom-copy .lead{color:#c9c4c1}.partner-list{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.partner-list span{display:grid;min-height:120px;place-items:center;padding:20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff;font-weight:800;text-align:center}.contact-cta .container{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:70px;border-radius:var(--radius-lg);background:#f6e3e2}.contact-cta h2{margin-bottom:12px}
@media(max-width:860px){.hero,.slides{min-height:780px}.hero-grid{grid-template-columns:1fr;padding-top:60px}.hero-art,.material-art,.custom-art{min-height:310px;height:310px}.hero-art img{width:260px}.orbit--a{width:300px;height:300px}.orbit--b{width:390px;height:390px}.story-grid,.custom-copy{grid-template-columns:1fr;gap:40px}.story-art{min-height:400px}.partner-list{grid-template-columns:1fr 1fr}.contact-cta .container{align-items:flex-start;flex-direction:column;padding:42px 28px}}
@media(max-width:560px){.hero-actions{align-items:stretch;flex-direction:column}.hero-actions .btn{width:100%}.partner-list{grid-template-columns:1fr}.hero h1{font-size:2.7rem}}
.slide{background-position:center;background-repeat:no-repeat;background-size:cover}.slide::before{position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.96) 0%,rgba(255,255,255,.74) 42%,rgba(255,255,255,0) 68%);content:""}.slide--one{background-image:url('/images/main/slide-01.jpg?v=20261122-2')}.slide--two{background-image:url('/images/main/slide-02.jpg?v=20261122-2')}.slide--three{background-image:url('/images/main/slide-03.jpg?v=20261122-2')}.hero-grid{position:relative;z-index:1;display:block}.hero-grid>div{max-width:760px}.hero h1{font-size:clamp(3.2rem,4.5vw,5rem)}@media(max-width:860px){.slide{background-position:68% center}.slide::before{background:rgba(255,255,255,.78)}.hero-grid{padding-top:0}}
</style>
