---
import { NAV_ITEMS } from '../lib/constants';
const path = Astro.url.pathname;
---
<header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="파우마우 홈"><img src="/images/brand/poumau-word.png" alt="POUMAU" /></a><button class="menu-toggle" type="button" aria-label="메뉴 열기" aria-expanded="false"><span></span><span></span><span></span></button><nav class="nav" aria-label="주요 메뉴">{NAV_ITEMS.map((item)=><a href={item.href} aria-current={path.startsWith(item.href)?'page':undefined}>{item.label}</a>)}<a class="btn btn--small" href="https://smartstore.naver.com/haruneko" target="_blank" rel="noreferrer">스마트스토어</a></nav></div></header>
<script>const header=document.querySelector<HTMLElement>('.site-header');const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('.nav');toggle?.addEventListener('click',()=>{const open=nav?.classList.toggle('is-open')??false;header?.classList.remove('is-hidden');toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'메뉴 닫기':'메뉴 열기');document.body.classList.toggle('menu-open',open)});let lastScrollY=window.scrollY;let scrollTicking=false;const updateHeader=()=>{const nextScrollY=Math.max(window.scrollY,0);const delta=nextScrollY-lastScrollY;const menuOpen=nav?.classList.contains('is-open')??false;if(menuOpen||nextScrollY<=16||delta<-4)header?.classList.remove('is-hidden');else if(delta>4&&nextScrollY>(header?.offsetHeight??78))header?.classList.add('is-hidden');lastScrollY=nextScrollY;scrollTicking=false};window.addEventListener('scroll',()=>{if(!scrollTicking){scrollTicking=true;window.requestAnimationFrame(updateHeader)}},{passive:true});</script>
<style>.site-header{transition:transform .3s ease}.site-header.is-hidden{transform:translateY(-100%)}</style>
